{
  "name": "writide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Markdown editor with live rendering and WebDAV workspaces",
  "author": "shiranzby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiranzby/Writide.git"
  },
  "bugs": {
    "url": "https://github.com/shiranzby/Writide/issues"
  },
  "homepage": "https://github.com/shiranzby/Writide#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server.mjs",
    "dev:vite": "vite",
    "start": "node server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.unit.mjs",
    "test:e2e": "playwright test -c playwright.portable.config.ts --workers=1",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "fast-xml-parser": "^5.11.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide": "^0.468.0",
    "markdown-it": "^14.3.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "vite": "^8.3.0"
  }
}
