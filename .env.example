# Optional exact browser origin, including scheme and port, without a path.
# Leave empty for automatic same-origin checks on simple LAN deployments.
WRITIDE_ORIGIN=
WRITIDE_BIND_IP=0.0.0.0
WRITIDE_USER=admin
# Initial password, at least 8 characters. Change the default in Settings after login.
WRITIDE_PASSWORD=password
# Public multi-architecture image; Docker selects amd64 or arm64 automatically.
WRITIDE_IMAGE=ghcr.io/shiranzby/writide:0.2.0
# Use prebuilt only when the source directory already includes dist/.
FRONTEND_SOURCE=build
